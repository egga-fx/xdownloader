{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xDownloader",
  "version": "1.0.1",
  "identifier": "com.eggafx.xdownloader",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "xDownloader",
        "width": 960,
        "height": 660,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxNDhCOUZCQkJFMjAxQjIKUldTeUFlSzcrN2xJSVpRMGJHTVRkZ2IzQjZENzVQQk8vQjRvUGFDenAwUU4wUWNoZTZSSFFFcXEK",
      "endpoints": [
        "https://github.com/egga-fx/xdownloader/releases/latest/download/latest.json"
      ]
    }
  }
}
